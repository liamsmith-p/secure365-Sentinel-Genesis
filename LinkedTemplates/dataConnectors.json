{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "enableDataConnectors": {
            "type": "array",
            "defaultValue": [],
            "metadata": {
                "description": "The kind of data connectors to enable"
            }
        },
        "aadStreams": {
            "type": "array",
            "metadata": {
                "description": "The list of data types to enable for Azure AD connector"
            },
            "defaultValue": []
        },
        "workspaceName": {
            "type": "string",
            "metadata": {
                "description": "Name for the Log Analytics workspace used to aggregate data"
            }
        },
        "location": {
            "type": "string",
            "defaultValue": "[resourceGroup().location]",
            "metadata": {
                "description": "Location for all resources."
            }
        }
    },
    "variables": {
        "tenantId": "[subscription().tenantId]",
        "subscriptionId": "[subscription().subscriptionId]",
        "ascName": "[concat('asc', uniqueString(resourceGroup().id))]",
        "mcasName": "[concat('mcas', uniqueString(resourceGroup().id))]",
        "aadipName": "[concat('aadip', uniqueString(resourceGroup().id))]",
        "tiName": "[concat('ti', uniqueString(resourceGroup().id))]",
        "azureActivityName": "[concat('azureactivity', uniqueString(resourceGroup().id))]",
        "office365Name": "[concat('office365', uniqueString(resourceGroup().id))]",
        "xdrName": "[concat('xdr', uniqueString(resourceGroup().id))]"
    },
    "resources": [
        {
            "condition": "[contains(parameters('enableDataConnectors'), 'MicrosoftEntraID')]",
            "type": "microsoft.aadiam/diagnosticSettings",
            "apiVersion": "2017-04-01",
            "scope": "/",
            "name": "[concat(parameters('workspaceName'), '-entraIdDiagnosticSettings')]",
            "properties": {
                "workspaceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]",
                "logs": [
                    { "category": "SignInLogs",                   "enabled": true, "retentionPolicy": { "days": 0, "enabled": false } },
                    { "category": "AuditLogs",                    "enabled": true, "retentionPolicy": { "days": 0, "enabled": false } },
                    { "category": "NonInteractiveUserSignInLogs", "enabled": true, "retentionPolicy": { "days": 0, "enabled": false } },
                    { "category": "ServicePrincipalSignInLogs",   "enabled": true, "retentionPolicy": { "days": 0, "enabled": false } },
                    { "category": "ManagedIdentitySignInLogs",    "enabled": true, "retentionPolicy": { "days": 0, "enabled": false } },
                    { "category": "ProvisioningLogs",             "enabled": true, "retentionPolicy": { "days": 0, "enabled": false } },
                    { "category": "ADFSSignInLogs",               "enabled": true, "retentionPolicy": { "days": 0, "enabled": false } },
                    { "category": "RiskyUsers",                   "enabled": true, "retentionPolicy": { "days": 0, "enabled": false } },
                    { "category": "UserRiskEvents",               "enabled": true, "retentionPolicy": { "days": 0, "enabled": false } },
                    { "category": "RiskyServicePrincipals",       "enabled": true, "retentionPolicy": { "days": 0, "enabled": false } },
                    { "category": "ServicePrincipalRiskEvents",   "enabled": true, "retentionPolicy": { "days": 0, "enabled": false } }
                ]
            }
        },
        {
            "condition": "[contains(parameters('enableDataConnectors'), 'AzureActiveDirectoryIDP')]",
            "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectors",
            "apiVersion": "2020-01-01",
            "location": "[parameters('location')]",
            "name": "[concat(parameters('workspaceName'),'/Microsoft.SecurityInsights/',variables('aadipName'))]",
            "kind": "AzureActiveDirectory",
            "properties": {
                "tenantId": "[variables('tenantId')]",
                "dataTypes": {
                    "alerts": {
                        "state": "enabled"
                    }
                }
            }
        },
        {
            "condition": "[contains(parameters('enableDataConnectors'), 'MicrosoftDefenderForCloud')]",
            "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectors",
            "apiVersion": "2020-01-01",
            "location": "[parameters('location')]",
            "name": "[concat(parameters('workspaceName'),'/Microsoft.SecurityInsights/',variables('ascName'))]",
            "kind": "AzureSecurityCenter",
            "properties": {
                "subscriptionId": "[variables('subscriptionId')]",
                "dataTypes": {
                    "alerts": {
                        "state": "enabled"
                    }
                }
            }
        },
        {
            "condition": "[contains(parameters('enableDataConnectors'), 'MicrosoftDefenderForCloudApps')]",
            "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectors",
            "apiVersion": "2022-12-01-preview",
            "location": "[parameters('location')]",
            "name": "[concat(parameters('workspaceName'),'/Microsoft.SecurityInsights/',variables('mcasName'))]",
            "kind": "MicrosoftCloudAppSecurity",
            "properties": {
                "tenantId": "[variables('tenantId')]",
                "dataTypes": {
                    "alerts": {
                        "state": "enabled"
                    },
                    "discoveryLogs": {
                        "state": "enabled"
                    }
                }
            }
        },
        {
            "condition": "[contains(parameters('enableDataConnectors'), 'AzureActivity')]",
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2021-04-01",
            "name": "azureActivityDiagnosticSetting",
            "location": "[parameters('location')]",
            "subscriptionId": "[variables('subscriptionId')]",
            "properties": {
                "mode": "Incremental",
                "expressionEvaluationOptions": {
                    "scope": "inner"
                },
                "template": {
                    "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                        "workspaceId": {
                            "type": "string"
                        }
                    },
                    "resources": [
                        {
                            "type": "Microsoft.Insights/diagnosticSettings",
                            "apiVersion": "2021-05-01-preview",
                            "name": "sentinel-azure-activity",
                            "properties": {
                                "workspaceId": "[parameters('workspaceId')]",
                                "logs": [
                                    { "category": "Administrative", "enabled": true },
                                    { "category": "Security", "enabled": true },
                                    { "category": "ServiceHealth", "enabled": true },
                                    { "category": "Alert", "enabled": true },
                                    { "category": "Recommendation", "enabled": true },
                                    { "category": "Policy", "enabled": true },
                                    { "category": "Autoscale", "enabled": true },
                                    { "category": "ResourceHealth", "enabled": true }
                                ]
                            }
                        }
                    ]
                },
                "parameters": {
                    "workspaceId": {
                        "value": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]"
                    }
                }
            }
        },
        {
            "condition": "[contains(parameters('enableDataConnectors'), 'MicrosoftDefenderXDR')]",
            "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectors",
            "apiVersion": "2022-12-01-preview",
            "location": "[parameters('location')]",
            "name": "[concat(parameters('workspaceName'),'/Microsoft.SecurityInsights/',variables('xdrName'))]",
            "kind": "MicrosoftThreatProtection",
            "properties": {
                "tenantId": "[variables('tenantId')]",
                "dataTypes": {
                    "incidents": {
                        "state": "enabled"
                    },
                    "alerts": {
                        "state": "enabled"
                    }
                }
            }
        },
        {
            "condition": "[contains(parameters('enableDataConnectors'), 'Office365')]",
            "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectors",
            "apiVersion": "2020-01-01",
            "location": "[parameters('location')]",
            "name": "[concat(parameters('workspaceName'),'/Microsoft.SecurityInsights/',variables('office365Name'))]",
            "kind": "Office365",
            "properties": {
                "tenantId": "[variables('tenantId')]",
                "dataTypes": {
                    "exchange": {
                        "state": "enabled"
                    },
                    "sharePoint": {
                        "state": "enabled"
                    },
                    "teams": {
                        "state": "enabled"
                    }
                }
            }
        }
    ]
}
